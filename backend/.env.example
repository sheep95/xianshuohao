# Copy to backend/.env. The app always reads that path, regardless of working directory.
APP_ENV=development

# Defaults to backend/data/app.db. Development auto-migrates on startup.
# DATABASE_URL=sqlite:///D:/your-project/backend/data/app.db
# PostgreSQL: DATABASE_URL=postgresql+psycopg://user:password@host:5432/database?sslmode=require&connect_timeout=5
AUTO_MIGRATE=true
SESSION_DAYS=180
WRITE_LIMIT_PER_MINUTE=60
# Production forces AUTO_MIGRATE=false; run python -m app.core.migrate first.

# JSON array, not a comma-separated string. Use actual frontend origins in production.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Stage 6: only an explicit generate action calls the provider, once for all five rules.
# Missing key/model, invalid output, network errors or a 3s total timeout use templates.
# Use a base URL including /v1 (or your provider's equivalent), not /chat/completions.
# Remote/production providers must use HTTPS. Restart the backend after changes.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
